[Unit]
Description=Kapsel resident preview
StartLimitIntervalSec=0

[Service]
Type=exec
User=kapsel
Group=kapsel-preview-callers
RuntimeDirectory=kapsel
RuntimeDirectoryMode=0750
StateDirectory=kapsel
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/libexec/kapsel/kapseld --operator-config /etc/kapsel/operator.json --socket /run/kapsel/kapseld.sock
Restart=no
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
