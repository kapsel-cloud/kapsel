                  "--digest-key-file",
                  "/var/run/kapsel-keys/tombstone-digest.seed",
                  "--listen",
                  "0.0.0.0:8081"
                ],
                "ports": [
                  {
                    "name": "private-handoff",
                    "containerPort": 8081,
                    "protocol": "TCP"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi",
                    "ephemeral-storage": "128Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "256Mi",
                    "ephemeral-storage": "256Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true,
                  "runAsNonRoot": true
                },
                "volumeMounts": [
