{
  "api_version": "kapsel.sandbox.policy/v3",
  "kind": "UidBoundCleanupRule",
  "identity": "cleanup-v1",
  "failure_policy": "Fail",
  "validation_action": "Deny",
  "cleanup_identity": "system:serviceaccount:kapsel-sandbox-cleanup:kapsel-sandbox-cleanup",
  "required_fields": [
    "run_id",
    "cleanup_epoch",
    "kind",
    "namespace",
    "name",
    "uid_precondition",
    "cleanup_owner",
    "policy_revision",
    "propagation_policy"
  ],
  "required_cleanup_epoch_format": "cleanup-<run_id>-1",
  "closed_provisioning_generation": true,
  "deny_name_only_delete": true,
  "deny_canary_or_baseline": true,
  "unknown_behavior": "deny"
}
